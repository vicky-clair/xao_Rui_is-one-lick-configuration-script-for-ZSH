# ========================================
# ⏱️ Startup Timer (for performance insight)
# ========================================
ZSH_START_TIME=$(date +%s%3N)
precmd() {
  local end_time=$(date +%s%3N)
  local elapsed=$((end_time - ZSH_START_TIME))
  print -P "%F{green}⚡ Zsh 启动完成，用时 %F{yellow}${elapsed}ms%f"
  unset -f precmd
}

# ========================================
# ⚡ Instant Prompt (keep this near the top)
# ========================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ========================================
# 📦 Basic Environment
# ========================================
export PATH="$HOME/.local/bin:/opt/nvim:$HOME/go/bin:$HOME/.local/share/pnpm:$PATH"
export EDITOR=nvim
export BAT_THEME="tokyonight_night"

# ========================================
# 💎 Oh My Zsh + Powerlevel10k
# ========================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# ========================================
# ⚙️ Fast Plugin Loader (auto-check + skip missing)
# ========================================
autoload -U colors && colors

function ensure_plugin() {
  local name="$1" repo="$2" dir="$HOME/.oh-my-zsh/custom/plugins/$name"
  if [[ ! -d "$dir" ]]; then
    if [[ -o interactive ]]; then
      print -P "%F{yellow}[⚠️ 缺少插件]%f %F{cyan}$name%f → %F{green}$repo%f"
      print -P "  %F{blue}git clone $repo $dir%f"
      echo
    fi
  else
    plugins+=("$name")
  fi
}

# 初始化插件列表
plugins=(git sudo extract history-substring-search colored-man-pages)

# 检查外部插件（稳定组合）
ensure_plugin "zsh-autosuggestions" "https://github.com/zsh-users/zsh-autosuggestions.git"
ensure_plugin "zsh-syntax-highlighting" "https://github.com/zsh-users/zsh-syntax-highlighting.git"
ensure_plugin "zsh-completions" "https://github.com/zsh-users/zsh-completions.git"

# ========================================
# 🧠 Smart compinit 缓存机制（自动刷新 + 启动提速）
# ========================================
autoload -Uz compinit
zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"

if [[ -f "$zcompdump" && -n "$(find "$zcompdump" -mtime -10 2>/dev/null)" ]]; then
  compinit -C -d "$zcompdump" 2>/dev/null
else
  mkdir -p "${zcompdump:h}"
  compinit -d "$zcompdump"
fi

# ========================================
# 🌈 Load Oh My Zsh core
# ========================================
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ========================================
# 💎 Powerlevel10k
# ========================================
[[ -r ~/powerlevel10k/powerlevel10k.zsh-theme ]] && source ~/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# ========================================
# 🔌 Manual Plugin Setup
# ========================================
if [[ -d ~/.oh-my-zsh/custom/plugins/zsh-completions ]]; then
  fpath=(~/.oh-my-zsh/custom/plugins/zsh-completions $fpath)
fi

# ⚠️ zsh-syntax-highlighting 必须最后加载
if [[ -r ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# ========================================
# 🔧 工具加载状态展示
# ========================================
if [[ -o interactive ]]; then
  print -P "\n%F{blue}========================================%f"
  print -P "%F{blue}🔧 正在加载常用工具...%f"
  print -P "%F{blue}========================================%f\n"
fi

# ========================================
# 🦊 vfox
# ========================================
if command -v vfox &>/dev/null; then
  eval "$(vfox activate zsh)"
  print -P "%F{green}✓%f %F{cyan}vfox%f 已加载 (版本管理)"
fi

# ========================================
# 🗂️ Yazi helper function
# ========================================
if command -v yazi &>/dev/null; then
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
  print -P "%F{green}✓%f %F{cyan}yazi%f 文件管理器已集成 (命令: %F{yellow}y%f)"
fi

# ========================================
# 🔍 FZF Configuration
# ========================================
if command -v fzf &>/dev/null; then
  if command -v fd &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --hidden --strip-cwd-prefix --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type=d --hidden --strip-cwd-prefix --exclude .git'
    print -P "%F{green}✓%f %F{cyan}fd%f 已集成到 FZF"
  fi

  if command -v bat &>/dev/null && command -v eza &>/dev/null; then
    show_file_or_dir_preview='if [ -d {} ]; then eza --tree --color=always {} | head -200; else bat -n --color=always --line-range :500 {}; fi'
    export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"
    print -P "%F{green}✓%f %F{cyan}bat%f + %F{cyan}eza%f 预览集成完成"
  elif command -v bat &>/dev/null; then
    export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"
    print -P "%F{green}✓%f %F{cyan}bat%f 预览集成完成"
  elif command -v eza &>/dev/null; then
    export FZF_CTRL_T_OPTS="--preview 'eza --tree --color=always {} | head -200'"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"
    print -P "%F{green}✓%f %F{cyan}eza%f 目录预览集成完成"
  fi

  eval "$(fzf --zsh)"
  print -P "%F{green}✓%f %F{cyan}fzf%f 模糊查找已加载 (%F{yellow}Ctrl+R%f / %F{yellow}Ctrl+T%f / %F{yellow}Alt+C%f)"
fi

# ========================================
# 🕓 History Configuration
# ========================================
HISTFILE="$HOME/.zhistory"
SAVEHIST=2000
HISTSIZE=2000

setopt share_history
setopt hist_ignore_all_dups
setopt hist_verify
setopt hist_reduce_blanks
setopt inc_append_history

bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# ========================================
# ⚙️ Aliases & Utilities
# ========================================
if command -v eza &>/dev/null; then
  alias ls="eza --icons=always"
  alias ll="eza -lh --icons=always"
  alias la="eza -lah --icons=always"
  print -P "%F{green}✓%f %F{cyan}eza%f 现代化 ls 已启用 (别名: %F{yellow}ls%f, %F{yellow}ll%f, %F{yellow}la%f)"
fi

if command -v lazydocker &>/dev/null; then
  alias lzd="lazydocker"
  print -P "%F{green}✓%f %F{cyan}lazydocker%f 管理工具已启用 (命令: %F{yellow}lzd%f)"
fi

if command -v nvim &>/dev/null; then
  print -P "%F{green}✓%f %F{cyan}neovim%f 已设置为默认编辑器"
fi

alias grep="grep --color=auto"

if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  print -P "%F{green}✓%f %F{cyan}zoxide%f 智能跳转已启用 (命令: %F{yellow}z%f)"
fi

# ========================================
# 🚀 Fastfetch auto-run
# ========================================
if command -v fastfetch &>/dev/null; then
  print -P "%F{green}✓%f %F{cyan}fastfetch%f 系统信息工具已启动\n"
  fastfetch -c ~/.config/fastfetch/config.jsonc
fi

# ========================================
# ✅ 加载完成
# ========================================
if [[ -o interactive ]]; then
  print -P "\n%F{blue}========================================%f"
  print -P "%F{green}✅ ZSH 环境加载完成！%f"
  print -P "%F{blue}========================================%f\n"
fi
