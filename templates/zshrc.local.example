# ==============================================================================
# 用户个性化扩展配置文件 (~/.zshrc.local)
# ==============================================================================
# 💡 重要说明：
# 1. 独立维护保障：本项目所有安装器、更新器 (zsh-update) 与配置管理器 (zsh-config)
#    均绝对不会创建、修改或覆盖 ~/.zshrc.local 文件，配置 100% 由您独占掌控；
# 2. 加载时序设计：本文件在主配置及 OMZ 插件之后、语法高亮插件 (zsh-syntax-highlighting)
#    加载之前被引入。在此定义的别名、函数与环境变量，能完美被语法高亮识别，且不会被项目默认配置冲掉；
# 3. 生效方式：保存后在终端运行 exec zsh 或新开终端窗口即可无缝生效。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 个人环境变量与 PATH 路径扩展
# ------------------------------------------------------------------------------
# export GOPATH="$HOME/go"
# export GOROOT="/usr/local/go"
# export CARGO_HOME="$HOME/.cargo"
# export PNPM_HOME="$HOME/.local/share/pnpm"
# export PATH="$HOME/my-custom-bin:$PATH"

# ------------------------------------------------------------------------------
# 2. 个人日常常用命令别名 (Personal Aliases)
# ------------------------------------------------------------------------------
# alias c='clear'
# alias h='history 50'
# alias reload='exec zsh'
# alias myip='curl -fsSL cip.cc'

# Docker 与容器常用简写
# alias d='docker'
# alias dps='docker ps --format "table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}"'
# alias dcomp='docker compose'

# Git 常用高效简写 (与 OMZ git 插件互补)
# alias gco='git checkout'
# alias gcb='git checkout -b'
# alias gcm='git commit -m'
# alias gpl='git pull --ff-only'
# alias gps='git push'

# ------------------------------------------------------------------------------
