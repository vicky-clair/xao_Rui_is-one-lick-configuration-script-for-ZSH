#!/usr/bin/env bash\
# tmux_hwm_ultimate.sh ‚ÄÉ¥ Ultimate, non-blocking, Dracula-colored monitor for tmux status-right\
# Designed for Intel systems (works well on others). Calls are parallel + timeout protected.\
\
# === Config ===\
TIMEOUT_CMD="timeout 0.25"   # per-command timeout\
TMPDIR="/tmp"\
RAPL_PREV="$TMPDIR/.tmux_hwm_rapl_prev"\
CPU_PREV="$TMPDIR/.tmux_hwm_cpu_prev"\
DRACULA_GREEN="#[fg=colour82]"   # safe green\
DRACULA_YELLOW="#[fg=colour226]"\
DRACULA_ORANGE="#[fg=colour208]"\
DRACULA_RED="#[fg=colour196]"\
DRACULA_PURPLE="#[fg=colour141]"\
RESET="#[fg=default]"\
\
# helper safe run\
safe_run() {\
  # usage: safe_run <varname> <command...>\
  local var="$1"; shift\
  ( ${TIMEOUT_CMD} bash -c "$*" ) > /tmp/.tmux_hwm_tmp.$$."$var" 2>/dev/null &\
}\
\
# collect sensors once quickly (non-blocking)\
safe_run sensors sensors\
# collect nvme smart (if nvme exists)\
safe_run nvme nvme -v 2>/dev/null; safe_run nvme_tmp "nvme smart-log /dev/nvme0n1" \
# collect smartctl for /dev/sda\
safe_run smartctl "smartctl -A /dev/sda 2>/dev/null"\
# nvidia-smi (if)\
safe_run nvidia "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits" \
# gpu_busy for intel (if sysfs exists)\
safe_run igpu "cat /sys/class/drm/*/device/gpu_busy_percent 2>/dev/null | head -n1"\
# read /proc/stat (for cpu usage)\
safe_run procstat "cat /proc/stat"\
# read rapl energy if exists\
safe_run rapl "find /sys/class/powercap -maxdepth 2 -type f -name energy_uj 2>/dev/null | head -n1 | xargs -I{} sh -c 'echo {} && cat {}' 2>/dev/null"\
\
# wait briefly for background procs (but do not block long)\
wait_timeout() {\
  # wait up to 0.30s for background jobs\
  local max_wait=0.30\
  local slept=0\
  while [ $slept -lt 300 ]; do\
    # if all background jobs done, break\
    if ! jobs -p >/dev/null 2>&1; then break; fi\
    usleep 20000 2>/dev/null || sleep 0.02\
    slept=$((slept+20))\
    # but limit total to max_wait\
    if [ "$slept" -ge 300 ]; then break; fi\
  done\
}\
wait_timeout\
\
# helper read tmp results\
read_tmp() {\
  local k="$1"\
  if [ -f /tmp/.tmux_hwm_tmp.$$."$k" ]; then\
    cat /tmp/.tmux_hwm_tmp.$$."$k"\
  else\
    echo ""\
  fi\
}\
\
SENS_OUT="$(read_tmp sensors)"\
PROCSTAT="$(read_tmp procstat)"\
NVME_TMP="$(read_tmp nvme_tmp)"\
SMART_SDA="$(read_tmp smartctl)"\
NVIDIA_RAW="$(read_tmp nvidia)"\
IGPU_RAW="$(read_tmp igpu)"\
RAPL_RAW="$(read_tmp rapl)"\
\
# === CPU Package temp & cores from sensors output ===\
CPU_PKG=$(printf "%s" "$SENS_OUT" | awk -F'+' '/Package id 0/ {print $2; exit}' | sed 's/[^0-9.].*//g')\
[ -z "$CPU_PKG" ] && CPU_PKG="N/A"\
\
# cores (we'll show first two cores as requested)\
CORE0=$(printf "%s" "$SENS_OUT" | awk -F'+' '/^Core 0/ {print $2; exit}' | sed 's/[^0-9.].*//g')\
CORE1=$(printf "%s" "$SENS_OUT" | awk -F'+' '/^Core 1/ {print $2; exit}' | sed 's/[^0-9.].*//g')\
[ -z "$CORE0" ] && CORE0="N/A"\
[ -z "$CORE1" ] && CORE1="N/A"\
\
# === CPU Frequency (GHz) ===\
if [ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]; then\
  FREQ_KHZ=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || echo "")\
  if [ -n "$FREQ_KHZ" ]; then CPU_FREQ=$(awk "BEGIN{printf \"%.2f\", $FREQ_KHZ/1000000}"); else CPU_FREQ="N/A"; fi\
else\
  MHZ=$(awk -F: '/cpu MHz/ {print $2; exit}' /proc/cpuinfo | sed 's/ //g')\
  CPU_FREQ=$(awk "BEGIN{if($MHZ==\"\") print \"N/A\"; else printf \"%.2f\", $MHZ/1000}")\
fi\
\
# === NVMe / SSD temp ===\
NVME_TEMP="N/A"\
if echo "$NVME_TMP" | grep -iq "temperature"; then\
  NVME_TEMP=$(printf "%s" "$NVME_TMP" | awk -F: '/temperature/ {gsub(/[^0-9]/,\"\",$2); print $2; exit}')\
  [ -n "$NVME_TEMP" ] && NVME_TEMP="${NVME_TEMP}¬∞C"\
elif echo "$SMART_SDA" | grep -qiE "Temperature_Celsius|Airflow_Temperature_Cel"; then\
  tmp=$(printf "%s" "$SMART_SDA" | awk '/Temperature_Celsius|Airflow_Temperature_Cel/ {print $10; exit}')\
  [ -n "$tmp" ] && NVME_TEMP="${tmp}¬∞C"\
fi\
\
# === GPU temp & util ===\
GPU_TEMP="N/A"\
GPU_UTIL="N/A"\
if echo "$NVIDIA_RAW" | grep -qE '[0-9]'; then\
  # nvidia-smi returned lines like: "<util> %, <temp>"\
  # but we requested "utilization.gpu,temperature.gpu" -> parse first line\
  line=$(printf "%s" "$NVIDIA_RAW" | head -n1)\
  GPU_UTIL=$(printf "%s" "$line" | awk -F',' '{gsub(/[^0-9]/,"",$1); print $1}')\
  GPU_TEMP=$(printf "%s" "$line" | awk -F',' '{gsub(/[^0-9]/,"",$2); print $2}')\
  [ -n "$GPU_TEMP" ] && GPU_TEMP="${GPU_TEMP}¬∞C"\
  [ -n "$GPU_UTIL" ] && GPU_UTIL="${GPU_UTIL}%"\
else\
  # try intel/amd via sysfs or sensors\
  tmp=$(printf "%s" "$IGPU_RAW" | tr -d ' \n' )\
  if [ -n "$tmp" ]; then\
    GPU_UTIL="${tmp}%"\
  fi\
  # gpu temp from sensors heuristics\
  gtemp=$(printf "%s" "$SENS_OUT" | awk -F'+' '/(edge:|GPU core|i915|amdgpu)/ {gsub(/[^0-9.].*/,"",$2); print $2; exit}')\
  if [ -n "$gtemp" ]; then GPU_TEMP="${gtemp}¬∞C"; fi\
fi\
\
# === Fan RPM ===\
FAN_RPM=$(printf "%s" "$SENS_OUT" | awk '/fan[0-9]+:/ {gsub(/[^0-9]/, "", $2); print $2; exit}')\
[ -z "$FAN_RPM" ] && FAN_RPM="N/A" || FAN_RPM="${FAN_RPM}RPM"\
\
# === CPU power from RAPL (W) ===\
CPU_PWR="N/A"\
if [ -n "$RAPL_RAW" ]; then\
  # RAPL_RAW format: /sys/...<newline>ENERGYVAL\
  RPATH=$(printf "%s" "$RAPL_RAW" | head -n1)\
  RVAL=$(printf "%s" "$RAPL_RAW" | tail -n1)\
  if [ -n "$RVAL" ] && [ "$RVAL" -gt 0 ]; then\
    # compute delta vs prev\
    if [ -f "$RAPL_PREV" ]; then\
      read prev_e prev_t < "$RAPL_PREV" || true\
      now_e=$RVAL\
      now_t=$(date +%s)\
      dt=$((now_t - prev_t))\
      if [ "$dt" -gt 0 ] && [ "$now_e" -gt "$prev_e" ]; then\
        de=$((now_e - prev_e))\
        CPU_PWR=$(awk "BEGIN{printf \"%.1f\", ($de/($dt))/1000000}")\
      fi\
    fi\
    # store\
    printf "%s %s" "$RVAL" "$(date +%s)" > "$RAPL_PREV" 2>/dev/null\
  fi\
fi\
\
# === CPU usage bar (uses /proc/stat delta caching) ===\
CPU_USAGE="N/A"\
CPU_BAR=""\
if [ -n "$PROCSTAT" ]; then\
  # parse aggregate cpu line\
  cpu_line=$(printf "%s" "$PROCSTAT" | awk '/^cpu /{print; exit}')\
  if [ -n "$cpu_line" ]; then\
    # fields: user nice system idle iowait irq softirq steal guest guest_nice\
    read -r _ u n s i io irq sir st g gn <<<"$cpu_line"\
    total=$((u + n + s + i + io + irq + sir + st + g + gn))\
    idle=$((i + io))\
    # load prev\
    if [ -f "$CPU_PREV" ]; then\
      read prev_total prev_idle < "$CPU_PREV"\
      dtotal=$((total - prev_total))\
      didle=$((idle - prev_idle))\
      if [ "$dtotal" -gt 0 ]; then\
        cpu_percent=$(( (100 * (dtotal - didle)) / dtotal ))\
        CPU_USAGE="${cpu_percent}%"\
        # build bar of length 6\
        filled=$(( (cpu_percent * 6) / 100 ))\
        bar=""\
        for i in $(seq 1 $filled); do bar="${bar}‚É∂É®"; done\
        for i in $(seq 1 $((6-filled))); do bar="${bar}‚É∂Å"; done\
        CPU_BAR="$bar"\
      fi\
    fi\
    # save for next call\
    printf "%s %s" "$total" "$idle" > "$CPU_PREV" 2>/dev/null\
  fi\
fi\
\
# === Color helper by temp value (dracula palette) ===\
color_for_temp() {\
  local t=$1\
  t=${t%.*}\
  if [ "$t" = "N/A" ] || [ -z "$t" ]; then\
    echo "$DRACULA_PURPLE"\
  elif [ "$t" -ge 85 ]; then\
    echo "$DRACULA_RED"\
  elif [ "$t" -ge 70 ]; then\
    echo "$DRACULA_ORANGE"\
  elif [ "$t" -ge 55 ]; then\
    echo "$DRACULA_YELLOW"\
  else\
    echo "$DRACULA_GREEN"\
  fi\
}\
