c1_col=$(color_for_temp "${CORE1}")\
gpu_col=$(color_for_temp "$(printf "%s" "$GPU_TEMP" | sed 's/[^0-9].*//g')")\
nvme_col=$(color_for_temp "$(printf "%s" "$NVME_TEMP" | sed 's/[^0-9].*//g')")\
\
PKG_PART="${pkg_col}ÔÉ´É© ${CPU_PKG}¬∞C${RESET}"\
CORES_PART="${c0_col}C0:${CORE0}¬∞C${RESET} ${c1_col}C1:${CORE1}¬∞C${RESET}"\
GPU_PART="${gpu_col}GPU:${GPU_TEMP}${RESET}"\
NVME_PART="${nvme_col}NVMe:${NVME_TEMP}${RESET}"\
FREQ_PART="#[fg=colour250]${CPU_FREQ}GHz${RESET}"\
PWR_PART="#[fg=colour250]${CPU_PWR}W${RESET}"\
FAN_PART="#[fg=colour250]${FAN_RPM}${RESET}"\
CPUUSE_PART="#[fg=colour250]${CPU_BAR} ${CPU_USAGE}${RESET}"\
GPUUSE_PART="#[fg=colour250]${GPU_UTIL}${RESET}"\
\
# Final compact one-line for status-right\
echo "${PKG_PART} | ${CORES_PART} | ${CPUUSE_PART} | ${GPU_PART} ${GPUUSE_PART} | ${NVME_PART} | ${FREQ_PART} | P:${PWR_PART} | ${FAN_PART}"\
# cleanup tmp files\
rm -f /tmp/.tmux_hwm_tmp.$$.* 2>/dev/null || true\
EOF\
