sudo bash -c 'cat >/usr/local/bin/hw_monitor.sh' <<'EOF'\
#!/bin/bash\
\
# CPU Package Ê∏©Â∫¶\
CPU_PKG=$(sensors | awk '/Package id 0/ {print $4}')\
\
# NVMe Ê∏©Â∫¶\
if command -v nvme &>/dev/null; then\
    NVME_TEMP=$(nvme smart-log /dev/nvme0 | awk -F: '/temperature/ {print $2 "¬∞C"; exit}')\
else\
    NVME_TEMP="N/A"\
fi\
\
# SSD (SATA) Ê∏©Â∫¶ (smartctl)\
SSD_TEMP=$(sudo smartctl -A /dev/sda 2>/dev/null | awk '/Temperature_Celsius/ {print $10 "¬∞C"}')\
\
# GPU Ê∏©Â∫¶ËÉß™ÂÉ™®Ê£ÄÊµÉ´\
if command -v nvidia-smi &>/dev/null; then\
    GPU_TEMP=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader)\
elif sensors | grep -qi "amdgpu"; then\
    GPU_TEMP=$(sensors | awk '/edge:/ {print $2; exit}')\
else\
    GPU_TEMP="N/A"\
fi\
\
# È£ÉÆÊÉ©ÉßËΩ¨ÈÄÉøÊ£ÄÊµÉ´\
FAN_RPM=$(sensors | awk '/fan1/ {print $2 "RPM"; exit}')\
\
# ËæÉ≥ÂÉß∫\
echo "CPU:$CPU_PKG | GPU:$GPU_TEMP | NVMe:$NVME_TEMP | SSD:$SSD_TEMP | Fan:$FAN_RPM"\
EOF\
\
sudo chmod +x /usr/local/bin/hw_monitor.sh\

sudo bash -c 'cat >/usr/local/bin/hw_monitor_color.sh' <<'EOF'\
#!/usr/bin/env bash\
# hw_monitor_color.sh\
# Intel-oriented hardware monitor for tmux status-right\
# Outputs a single line with tmux color tokens.\
\
# Helper: color by temperature (returns tmux fg token)\
color_for_temp() {\
  local t=${1:-0}\
  t=${t%.*}\
  if [ "$t" -ge 85 ]; then\
    echo "#[fg=colour196]"   # red\
  elif [ "$t" -ge 70 ]; then\
    echo "#[fg=colour208]"   # orange\
  elif [ "$t" -ge 55 ]; then\
    echo "#[fg=colour226]"   # yellow\
  else\
    echo "#[fg=colour82]"    # green\
  fi\
}\
\
# read sensors output once to save time\
SENS_OUT=$(sensors 2>/dev/null)\
\
# CPU package temp\
CPU_PKG_RAW=$(printf "%s" "$SENS_OUT" | awk -F'+' '/Package id 0/ {print $2; exit}')\
CPU_PKG=$(printf "%s" "$CPU_PKG_RAW" | sed -E 's/[^0-9.].*//g')\
CPU_PKG=${CPU_PKG:-N/A}\
\
# Core temps (list)\
CORES_LINE=$(printf "%s" "$SENS_OUT" | awk -F'+' '/^Core [0-9]+:/ {printf "%s ", $2}')\
CORES_LIST=$(printf "%s" "$CORES_LINE" | sed -E 's/[^0-9. ]/ /g' | xargs)\
# build compact cores string like 46 46 46 46\
CORES_DISPLAY="N/A"\
if [ -n "$CORES_LIST" ]; then\
  CORES_DISPLAY=$(printf "%s" "$CORES_LIST" | awk '{for(i=1;i<=NF;i++){printf "%d", $i; if(i<NF) printf " ";}}')\
fi\
\
# CPU frequency (GHz) - prefer sysfs\
if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]; then\
  FREQ_KHZ=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || echo 0)\
  CPU_FREQ_GHZ=$(awk "BEGIN{printf \"%.2f\", $FREQ_KHZ/1000000}")\
else\
  # fallback to /proc/cpuinfo (cpu MHz)\
  mhz=$(awk -F: '/cpu MHz/ {print $2; exit}' /proc/cpuinfo | sed 's/ //g')\
  CPU_FREQ_GHZ=$(awk "BEGIN{if($mhz==\"\") print \"N/A\"; else printf \"%.2f\", $mhz/1000}")\
fi\
\
# CPU power via Intel RAPL (energy_uj delta)\
RAPL_PATH=$(find /sys/class/powercap -maxdepth 2 -type f -name energy_uj 2>/dev/null | head -n1)\
CPU_PWR="N/A"\
if [ -n "$RAPL_PATH" ]; then\
  PREV_FILE="/tmp/.hw_mon_rapl_prev"\
  now_e=$(cat "$RAPL_PATH" 2>/dev/null || echo "")\
  now_t=$(date +%s)\
  if [ -f "$PREV_FILE" ] && [ -n "$now_e" ]; then\
    read prev_e prev_t < "$PREV_FILE"\
    dt=$((now_t - prev_t))\
    if [ "$dt" -gt 0 ]; then\
      de=$((now_e - prev_e))\
      # energy_uj microjoules, power in watts = (de microJ / dt seconds) / 1e6\
      p=$(awk "BEGIN{printf \"%.1f\", ($de/($dt))/1000000}")\
      CPU_PWR="${p}W"\
    fi\
  fi\
  # store current\
  if [ -n "$now_e" ]; then\
    printf "%s %s" "$now_e" "$now_t" > "$PREV_FILE" 2>/dev/null\
  fi\
fi\
\
# NVMe temp (if nvme present)\
NVME_TEMP="N/A"\
if command -v nvme >/dev/null 2>&1; then\
  # try common nvme device\
  NVDEV=$(ls /dev/nvme?n* 2>/dev/null | head -n1)\
  if [ -n "$NVDEV" ]; then\
    tmp=$(nvme smart-log "$NVDEV" 2>/dev/null | awk -F: '/temperature/ {gsub(/[^0-9]/, \"\", $2); print $2; exit}')\
    if [ -n "$tmp" ]; then NVME_TEMP="${tmp}¬∞C"; fi\
  fi\
fi\
# fallback using smartctl for /dev/sda\
if [ "$NVME_TEMP" = "N/A" ] && command -v smartctl >/dev/null 2>&1; then\
  if [ -b /dev/sda ]; then\
    tmp=$(smartctl -A /dev/sda 2>/dev/null | awk '/Temperature_Celsius|Airflow_Temperature_Cel/ {print $10; exit}')\
    if [ -n "$tmp" ]; then NVME_TEMP="${tmp}¬∞C"; fi\
  fi\
fi\
\
# GPU temp detection: NVIDIA -> nvidia-smi, AMD/Intel -> sensors\
GPU_TEMP="N/A"\
if command -v nvidia-smi >/dev/null 2>&1; then\
  g=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)\
  [ -n "$g" ] && GPU_TEMP="${g}¬∞C"\
else\
  # try sensors for amd/i915\
  g=$(printf "%s" "$SENS_OUT" | awk -F'+' '/(edge:|GPU core|i915|amdgpu)/{for(i=2;i<=NF;i++){if($i ~ /[0-9]+\\.?[0-9]*/){gsub(/[^0-9.].*/,"",$i); print $i; exit}}}' | head -n1)\
  [ -n "$g" ] && GPU_TEMP="${g}¬∞C"\
fi\
\
# Fan RPM\
FAN_RPM=$(printf "%s" "$SENS_OUT" | awk '/fan[0-9]+:/ {gsub(/[^0-9]/, "", $2); print $2; exit}')\
[ -n "$FAN_RPM" ] && FAN_RPM="${FAN_RPM}RPM" || FAN_RPM="N/A"\
\
# Build colored segments\
pkg_color=$(color_for_temp "${CPU_PKG%%.*}")\
core_color=$(color_for_temp "${CPU_PKG%%.*}")\
\
# CPU package display\
if [ "$CPU_PKG" != "N/A" ]; then\
  CPU_PKG_DISPLAY="${pkg_color}ÔÉ´É© ${CPU_PKG}¬∞C#[fg=default]"\
else\
  CPU_PKG_DISPLAY="#[fg=colour244]ÔÉ´É© N/A#[fg=default]"\
fi\
\
# cores display (show up to 4 cores compact)\
CORES_PART=""\
if [ "$CORES_DISPLAY" != "N/A" ]; then\
  i=0\
  for c in $CORES_DISPLAY; do\
    c_int=$(printf "%d" "$c")\
    col=$(color_for_temp "$c_int")\
    CORES_PART="${CORES_PART}${col}${c_int}¬∞C#[fg=default]"\
    i=$((i+1))\
    if [ $i -ge 4 ]; then break; fi\
    CORES_PART="${CORES_PART} "\
  done\
else\
  CORES_PART="#[fg=colour244]N/A#[fg=default]"\
fi\
\
# GPU\
GPU_PART=""\
if [ "$GPU_TEMP" != "N/A" ]; then\
  gval=${GPU_TEMP%%¬∞C}\
  gcol=$(color_for_temp "$gval")\
  GPU_PART="${gcol}GPU:${gval}¬∞C#[fg=default]"\
else\
  GPU_PART="#[fg=colour244]GPU:N/A#[fg=default]"\
fi\
\
# NVMe/SSD\
NVME_PART=""\
if [ "$NVME_TEMP" != "N/A" ]; then\
  nval=$(printf "%s" "$NVME_TEMP" | sed 's/[^0-9]*//g')\
  ncol=$(color_for_temp "$nval")\
  NVME_PART="${ncol}NVMe:${nval}¬∞C#[fg=default]"\
else\
  NVME_PART="#[fg=colour244]NVMe:N/A#[fg=default]"\
fi\
\
# Frequency & Power & Fan\
FREQ_PART="#[fg=colour250]${CPU_FREQ_GHZ}GHz#[fg=default]"\
PWR_PART="#[fg=colour250]${CPU_PWR}#[fg=default]"\
